{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "esModuleInterop": true, "strict": true,
    "skipLibCheck": true, "noEmit": true, "noUnusedLocals": true,
    "baseUrl": ".", "lib": ["ES2020", "DOM"],
    "paths": {
      "react": ["editor/node_modules/@types/react"],
      "react/jsx-runtime": ["editor/node_modules/@types/react/jsx-runtime"],
      "remotion": ["editor/node_modules/remotion"]
    }
  },
  "include": ["motion-graphics/**/*.tsx"]
}
